<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;800;900&family=Sora:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#14111C;
    --surface:#1E1930;
    --surface-2:#261F3B;
    --gold:#F5B942;
    --coral:#FF6B5B;
    --paper:#F3EDE4;
    --muted:#A79BC4;
    --line: rgba(243,237,228,0.12);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--paper);
    font-family:'Sora', sans-serif;
    line-height:1.6;
    overflow-x:hidden;
  }
  h1,h2,h3,.display{
    font-family:'Unbounded', sans-serif;
    line-height:1.1;
    letter-spacing:-0.01em;
  }
  .mono{
    font-family:'Space Mono', monospace;
  }
  a{color:inherit; text-decoration:none;}
  img{max-width:100%; display:block;}
  .wrap{
    max-width:1100px;
    margin:0 auto;
    padding:0 28px;
  }
  ::selection{background:var(--gold); color:var(--ink);}

  /* NAV */
  header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    backdrop-filter:blur(10px);
    background:rgba(20,17,28,0.72);
    border-bottom:1px solid var(--line);
  }
  nav.wrap{
    display:flex; align-items:center; justify-content:space-between;
    padding-top:16px; padding-bottom:16px;
  }
  .logo{
    font-family:'Unbounded', sans-serif;
    font-weight:800;
    font-size:1.05rem;
    letter-spacing:0.02em;
    display:flex; align-items:center;
  }
  .logo-img{
    height:42px; width:auto; border-radius:6px;
  }
  .navlinks{display:flex; gap:32px; font-size:0.9rem;}
  .navlinks a{
    color:var(--muted);
    transition:color .2s ease;
    position:relative;
  }
  .navlinks a:hover, .navlinks a:focus-visible{color:var(--paper);}
  .navlinks a::after{
    content:''; position:absolute; left:0; bottom:-6px; height:2px; width:0;
    background:var(--gold); transition:width .25s ease;
  }
  .navlinks a:hover::after{width:100%;}
  .navtoggle{display:none;}

  /* EQ BARS — signature motif */
  .eq{
    display:flex; align-items:flex-end; gap:6px; height:60px;
  }
  .eq span{
    width:6px; border-radius:3px;
    background:linear-gradient(180deg, var(--gold), var(--coral));
    animation:bounce 1.2s ease-in-out infinite;
    transform-origin:bottom;
  }
  .eq span:nth-child(1){height:30%; animation-delay:-0.9s;}
  .eq span:nth-child(2){height:70%; animation-delay:-0.6s;}
  .eq span:nth-child(3){height:45%; animation-delay:-1.1s;}
  .eq span:nth-child(4){height:90%; animation-delay:-0.3s;}
  .eq span:nth-child(5){height:55%; animation-delay:-0.75s;}
  .eq span:nth-child(6){height:80%; animation-delay:-0.15s;}
  .eq span:nth-child(7){height:35%; animation-delay:-1.0s;}
  .eq span:nth-child(8){height:65%; animation-delay:-0.45s;}
  .eq span:nth-child(9){height:25%; animation-delay:-0.9s;}
  @keyframes bounce{
    0%,100%{transform:scaleY(0.3);}
    50%{transform:scaleY(1);}
  }
  @media (prefers-reduced-motion: reduce){
    .eq span{animation:none; transform:scaleY(0.7);}
  }

  .divider{
    display:flex; justify-content:center; gap:5px; padding:70px 0;
    opacity:0.55;
  }
  .divider span{
    width:4px; height:18px; border-radius:2px;
    background:var(--muted);
  }
  .divider span:nth-child(odd){height:28px; background:var(--gold);}

  /* HERO */
  .hero{
    min-height:100vh;
    display:flex; flex-direction:column; justify-content:center;
    position:relative;
    padding-top:120px; padding-bottom:80px;
    overflow:hidden;
  }
  .hero-bg{
    position:absolute; inset:0;
    background-image:linear-gradient(180deg, rgba(20,17,28,0.55) 0%, rgba(20,17,28,0.85) 55%, var(--ink) 100%), url('images/hero-bg.jpg');
    background-size:cover;
    background-position:center 20%;
    filter:saturate(1.05);
  }
  .hero-eq{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    opacity:0.14; pointer-events:none;
  }
  .hero-eq .eq{height:70vh; gap:14px;}
  .hero-eq .eq span{width:18px;}
  .eyebrow{
    font-family:'Space Mono', monospace;
    color:var(--gold);
    font-size:0.8rem;
    letter-spacing:0.25em;
    text-transform:uppercase;
    margin-bottom:20px;
  }
  .hero h1{
    font-size:clamp(3.2rem, 11vw, 8rem);
    font-weight:900;
    color:var(--paper);
  }
  .hero .role{
    font-size:clamp(1.1rem, 2.6vw, 1.6rem);
    color:var(--muted);
    margin-top:18px;
    font-weight:500;
  }
  .hero p.lede{
    max-width:520px;
    margin-top:22px;
    color:var(--muted);
    font-size:1.05rem;
  }
  .cta-row{
    display:flex; gap:16px; margin-top:40px; flex-wrap:wrap;
  }
  .btn{
    display:inline-flex; align-items:center; gap:10px;
    padding:14px 26px;
    border-radius:999px;
    font-weight:600;
    font-size:0.95rem;
    transition:transform .2s ease, box-shadow .2s ease;
    border:1px solid transparent;
  }
  .btn-primary{
    background:var(--gold); color:var(--ink);
  }
  .btn-primary:hover{transform:translateY(-2px); box-shadow:0 10px 30px rgba(245,185,66,0.25);}
  .btn-ghost{
    border-color:var(--line); color:var(--paper);
  }
  .btn-ghost:hover{border-color:var(--gold); color:var(--gold);}

  /* SECTION HEADS */
  .section{padding:40px 0 20px;}
  .kicker{
    font-family:'Space Mono', monospace;
    font-size:0.78rem;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:14px;
  }
  .section h2{
    font-size:clamp(2rem, 5vw, 3rem);
    margin-bottom:28px;
  }

  /* ABOUT */
  .about-grid{
    display:grid; grid-template-columns:0.9fr 1.1fr; gap:56px; align-items:start;
  }
  .photo-frame{
    aspect-ratio:4/5;
    border-radius:18px;
    background:linear-gradient(155deg, var(--surface), var(--surface-2));
    border:1px dashed var(--line);
    display:flex; align-items:center; justify-content:center;
    text-align:center;
    color:var(--muted);
    font-family:'Space Mono', monospace;
    font-size:0.85rem;
    padding:24px;
    position:relative;
    overflow:hidden;
  }
  .photo-frame.filled{border-style:solid; padding:0;}
  .photo-frame.filled img{width:100%; height:100%; object-fit:cover;}
  .about-text p{color:var(--muted); margin-bottom:18px; font-size:1.02rem;}
  .about-text strong{color:var(--paper);}

  /* MUSIC */
  .album-list{display:flex; flex-direction:column; gap:2px;}
  .album{
    display:grid; grid-template-columns:120px 1fr auto; gap:24px; align-items:center;
    padding:26px 0;
    border-top:1px solid var(--line);
  }
  .album:last-child{border-bottom:1px solid var(--line);}
  .art-wrap{
    width:120px; height:120px; border-radius:10px; overflow:hidden;
    position:relative;
    background:var(--surface);
  }
  .art-wrap img{width:100%; height:100%; object-fit:cover; transition:transform .5s ease;}
  .album:hover .art-wrap img{transform:scale(1.08) rotate(-2deg);}
  .album-meta h3{font-size:1.25rem; margin-bottom:6px;}
  .album-meta .details{
    font-family:'Space Mono', monospace;
    font-size:0.78rem;
    color:var(--muted);
    margin-bottom:10px;
  }
  .stream-links{display:flex; gap:14px; flex-wrap:wrap; font-size:0.85rem;}
  .stream-links a{color:var(--muted); border-bottom:1px solid transparent;}
  .stream-links a:hover{color:var(--gold); border-color:var(--gold);}
  .buy-col{display:flex; flex-direction:column; align-items:flex-end; gap:8px;}
  .buy-btn{
    font-family:'Space Mono', monospace;
    font-size:0.78rem;
    letter-spacing:0.05em;
    text-transform:uppercase;
    padding:10px 18px;
    border-radius:999px;
    background:var(--surface-2);
    border:1px solid var(--line);
    color:var(--muted);
    white-space:nowrap;
  }
  .buy-btn:hover{border-color:var(--gold); color:var(--gold);}

  /* GALLERY */
  .gallery-grid{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:14px;
  }
  .gallery-tile{
    aspect-ratio:1/1; border-radius:12px;
    background:var(--surface);
    border:1px dashed var(--line);
    display:flex; align-items:center; justify-content:center;
    color:var(--muted);
    font-family:'Space Mono', monospace;
    font-size:0.75rem;
    text-align:center;
    padding:14px;
    overflow:hidden;
  }
  .gallery-tile.filled{border-style:solid; padding:0;}
  .gallery-tile.filled img{width:100%; height:100%; object-fit:cover; transition:transform .5s ease;}
  .gallery-tile.filled:hover img{transform:scale(1.06);}

  /* CONTACT */
  .contact-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:56px;
  }
  .contact-info .row{
    padding:18px 0; border-top:1px solid var(--line);
  }
  .contact-info .row:last-child{border-bottom:1px solid var(--line);}
  .contact-info .label{
    font-family:'Space Mono', monospace;
    font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase;
    color:var(--gold); margin-bottom:6px;
  }
  .contact-info .value{font-size:1.1rem;}
  .social-row{display:flex; gap:18px; margin-top:20px;}
  .social-row a{
    color:var(--muted); font-size:0.9rem; border-bottom:1px solid var(--line);
    padding-bottom:2px;
  }
  .social-row a:hover{color:var(--gold); border-color:var(--gold);}

  form{display:flex; flex-direction:column; gap:14px;}
  input, textarea{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px 16px;
    color:var(--paper);
    font-family:'Sora', sans-serif;
    font-size:0.95rem;
  }
  input:focus, textarea:focus{outline:2px solid var(--gold); outline-offset:1px;}
  textarea{resize:vertical; min-height:120px;}
  form button{
    font-family:'Sora', sans-serif;
    cursor:pointer;
    align-self:flex-start;
  }

  footer{
    padding:50px 0 40px;
    border-top:1px solid var(--line);
    color:var(--muted);
    font-size:0.85rem;
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;
  }

  .reveal{
    opacity:0; transform:translateY(28px);
    transition:opacity .7s ease, transform .7s ease;
  }
  .reveal.in{opacity:1; transform:translateY(0);}
  @media (prefers-reduced-motion: reduce){
    .reveal{opacity:1; transform:none; transition:none;}
  }

  /* FEATURED RELEASE */
  .featured{
    display:grid; grid-template-columns:280px 1fr; gap:44px; align-items:center;
    background:linear-gradient(155deg, var(--surface), var(--surface-2));
    border:1px solid var(--line);
    border-radius:22px;
    padding:36px;
    margin-bottom:56px;
    position:relative;
    overflow:hidden;
  }
  .featured::before{
    content:''; position:absolute; top:-40%; right:-10%; width:280px; height:280px;
    background:radial-gradient(circle, rgba(245,185,66,0.18), transparent 70%);
    pointer-events:none;
  }
  .featured .art-wrap{width:280px; height:280px; border-radius:16px;}
  .featured-tag{
    font-family:'Space Mono', monospace; font-size:0.75rem; letter-spacing:0.15em;
    text-transform:uppercase; color:var(--coral); margin-bottom:12px;
  }
  .featured h3{font-size:1.9rem; margin-bottom:10px;}
  .featured p{color:var(--muted); margin-bottom:20px; max-width:440px;}

  /* PRESS / EPK STRIP */
  .press-strip{
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px;
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:16px;
    padding:26px 32px;
    margin-top:36px;
  }
  .press-strip .ptext h4{font-size:1.05rem; margin-bottom:4px;}
  .press-strip .ptext p{color:var(--muted); font-size:0.9rem; max-width:420px;}

  @media (max-width: 780px){
    .featured{grid-template-columns:1fr; text-align:left;}
    .featured .art-wrap{width:100%; height:auto; aspect-ratio:1/1;}
  }

  @media (max-width: 780px){
    .navlinks{
      position:fixed; top:64px; left:0; right:0; bottom:0;
      background:var(--ink);
      flex-direction:column; align-items:flex-start; gap:0;
      padding:12px 28px;
      transform:translateX(100%);
      transition:transform .3s ease;
    }
    .navlinks.open{transform:translateX(0);}
    .navlinks a{padding:16px 0; width:100%; border-bottom:1px solid var(--line);}
    .navtoggle{
      display:block; background:none; border:none; color:var(--paper);
      font-size:1.4rem; cursor:pointer;
    }
    .about-grid, .contact-grid{grid-template-columns:1fr;}
    .album{grid-template-columns:80px 1fr; row-gap:14px;}
    .art-wrap{width:80px; height:80px;}
    .buy-col{grid-column:1 / -1; align-items:flex-start;}
    .gallery-grid{grid-template-columns:repeat(2, 1fr);}
  }
</style>
</head>
